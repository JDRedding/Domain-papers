import numpy as np
import matplotlib.pyplot as plt

def elementary_ca(rule, steps=100, width=201, initial='single'):
    """Simulate elementary cellular automaton."""
    # Convert rule to binary lookup
    rule_bin = np.array([int(x) for x in f'{rule:08b}'], dtype=int)
    # Neighborhood indices: 7=111, 6=110, ..., 0=000
    lookup = rule_bin[::-1]  # so index 0 is 000, etc.? Wait, standard is MSB for 111
    
    # Actually standard Wolfram: binary of rule, leftmost bit for 111
    # rule_bin[0] is for 111 (bit 7), rule_bin[7] for 000
    # So lookup[7] = rule_bin[0] for neighborhood 7, etc.
    # Better:
    def get_next(state):
        # Pad for periodic? or fixed 0
        padded = np.pad(state, 1, mode='constant', constant_values=0)
        neighborhoods = 4*padded[:-2] + 2*padded[1:-1] + padded[2:]
        return rule_bin[7 - neighborhoods]  # since rule_bin[0] for 7
    
    # Initial condition
    state = np.zeros(width, dtype=int)
    if initial == 'single':
        state[width//2] = 1
    elif initial == 'random':
        state = np.random.randint(0, 2, width)
    
    history = [state.copy()]
    for _ in range(steps-1):
        state = get_next(state)
        history.append(state.copy())
    
    return np.array(history)

