RDGMFEQ_GEOMETRIC_INSTRUMENT_OPERATORS
Types, Variables, Fundamentals

====================================================================
TYPE DEFINITIONS
====================================================================

TYPE SID = {Structure, Interaction, Dynamics}
TYPE PED = {Power, Evaluation, Dynamics}

TYPE RDG_Operator =
    IsoOp          // metric‑preserving map
    PhaseOp        // angle/phase extraction
    AlignOp        // micro‑alignment (Δ‑resolution)
    SimOp          // similarity/proportional operator
    LinMap         // homothety / linear scaling
    ConicDyn       // constrained‑motion curve generator
    MomentEq       // equilibrium solver
    ProjExtract    // projective direction extractor

TYPE Instrument =
    VernierCaliper
    DividerCompass
    Protractor
    Sector
    ProportionalDivider
    Ellipsograph
    BalanceScale
    SurveyQuadrant


====================================================================
VARIABLES
====================================================================

r_main        // main scale reading
r_vernier     // vernier scale reading
k             // coincidence index
d(P,Q)        // metric distance between points P and Q
θ             // angular phase variable
a,b           // ellipse semi‑axes parameters
x(θ), y(θ)    // parametric curve coordinates
m1, m2        // masses on balance arms
d1, d2        // moment arms
dir(P)        // projective direction of point P
λ             // linear scaling factor (homothety)
Δ             // micro‑alignment offset


