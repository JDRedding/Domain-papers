type Apple1 {
  nickname        : string   = "Hatfield"
  registry_id     : int      = 48
  year            : int      = 1976
  cpu             : chip     = MOS 6502
  ram             : bytes    = 8 KB
  condition       : bool     = true          // operational
  estimate_usd    : range    = 500000..800000
  auction         : house    = Bonhams
  sale_window     : date     = 2026-10-04 to 2026-10-14
