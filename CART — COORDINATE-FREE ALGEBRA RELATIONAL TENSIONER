6. PLANTUML REPRESENTATION (OPTIONAL)
-------------------------------------

@startuml

class Carrier {
    - configurations
    - representation
}

class Kernel {
    - idempotent
    - contractive
    + apply(x)
    + resolve(x)
}

class Defect {
    - defectValue
    + compute(x, Kx)
    + evaluate()
}

class AdmissibilityQuotient {
    - classes
    + classOf(x)
    + isAdmissible(x)
}

class Hierarchy {
    - tier : Tier
    + depthOf(class)
    + neighbors(class)
}

enum Tier {
    Tier1
    Tier2
    Tier3
}

Carrier --> Kernel
Kernel --> Defect
Defect --> AdmissibilityQuotient
AdmissibilityQuotient --> Hierarchy
Hierarchy --> Tier

@enduml

