kill <PID>               # terminate
kill -9 <PID>            # force
pkill name               # by name
pgrep name               # get PIDs
nice -n 10 cmd           # lower priority
renice -n 5 -p <PID>     # change priority
jobs                     # background jobs
fg / bg                  # foreground / background

