=== 2. FILE AND DIRECTORY OPERATIONS ===
ls                       # list
ls -l                    # long
ls -la                   # hidden too
cd <dir>                 # change dir
pwd                      # current path
mkdir <dir>              # create dir
mkdir -p a/b/c           # nested
rmdir <dir>              # empty dir only
rm <file>                # delete file
rm -r <dir>              # recursive
rm -rf <dir>             # force (careful)
cp <src> <dst>           # copy
cp -r <src> <dst>        # copy dir
mv <src> <dst>           # move / rename
touch <file>             # empty file / update time
file <file>              # type
stat <file>              # metadata
ln -s <src> <link>       # symlink
find <dir> -name "*.txt" # search by name
locate <file>            # fast (updatedb)
which <cmd>              # binary path
whereis <cmd>            # bin + man + source

=== 3. FILE CONTENT OPERATIONS ===
cat <file>               # print all
less <file>              # page (q to quit)
head -n 20 <file>        # first lines
tail -n 20 <file>        # last lines
tail -f <file>           # follow (logs)
wc -l <file>             # line/word/byte count
grep "text" <file>       # search
grep -r "text" <dir>     # recursive
sed 's/old/new/g' file   # replace
awk '{print $1}' file    # first column
sort file                # sort
uniq file                # unique lines
diff file1 file2         # differences
cut -d',' -f1 file       # extract field
tr 'a-z' 'A-Z' < file    # translate
tee file                 # print + write
echo "hi" > file         # overwrite
echo "hi" >> file        # append

=== 4. USER AND PERMISSIONS ===
who                      # logged in
w                        # who + what
adduser <user>           # new user
passwd <user>            # password
usermod -aG <grp> <user> # add to group
deluser <user>           # delete user
groups <user>            # groups
chmod 755 <file>
chmod +x <file>
chown user:group <file>
chgrp group <file>
umask                    # default perms
sudo <cmd>               # as root
su -                     # switch to root

=== 5. PROCESS MANAGEMENT ===
